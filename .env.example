# Copy to .env for local runs. On Azure, set these as App Service application settings instead.

# --- Storage (uncomment both lines only after you have real values; otherwise the app runs in local demo mode) ---
# COSMOS_ENDPOINT=https://cosmos-cybersecurity.documents.azure.com:443/
# Account key (simplest). Delete this line to use managed identity / `az login` instead (see README).
# COSMOS_KEY=<primary-key-from-azure-portal>

# --- Dashboard login ---
ADMIN_USER=admin
ADMIN_PASSWORD=ChangeMe-123

# --- Optional: Application Insights ---
# APPLICATIONINSIGHTS_CONNECTION_STRING=<from the Application Insights Overview page>

# --- Optional: alert delivery (either or both) ---
# ALERT_WEBHOOK_URL=<HTTP POST URL of an Azure Logic App>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=<app-password>
# ALERT_EMAIL_TO=you@gmail.com
